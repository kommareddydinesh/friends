      body: Column(
        children: [
          TextField(
            controller: search,
            decoration: InputDecoration(
              hintText: "Search product",
            ),
            onChanged: (value) {
              setState(() {});
            },
          ),
          Expanded(
            child: ListView(
              children: products
                  .where((item) => item.toLowerCase()
                      .contains(search.text.toLowerCase()))
