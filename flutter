import 'package:flutter/material.dart';
void main() {
  runApp(MaterialApp(home: MileagePage()));
}
class MileagePage extends StatefulWidget {
  @override
  State<MileagePage> createState() => _MileagePageState();
}
class _MileagePageState extends State<MileagePage> {
  final key = GlobalKey<FormState>();
  final distance = TextEditingController();
  final fuel = TextEditingController();
  String result = "";
  void calculate() {
    if (key.currentState!.validate()) {
      double d = double.parse(distance.text);
      double f = double.parse(fuel.text);
      setState(() {
        result = "Mileage: ${ (d / f).toStringAsFixed(2) } km/l";
      });
    }
  }
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.orange.shade50,
      appBar: AppBar(
        title: Text("Mileage Calculator"),
        backgroundColor: Colors.deepOrange,
        foregroundColor: Colors.white,
      ),
      body: Padding(
        padding: EdgeInsets.all(20),
        child: Form(
          key: key,
          child: Column(
            children: [
              TextFormField(
                controller: distance,
                keyboardType: TextInputType.number,
                decoration: InputDecoration(
                  labelText: "Distance (km)",
                  prefixIcon: Icon(Icons.speed),
                  filled: true,
                  fillColor: Colors.white,
                  border: OutlineInputBorder(),
                ),
                validator: (v) =>
                    v!.isEmpty ? "Enter distance" : null,
              ),
              SizedBox(height: 15),
              TextFormField(
                controller: fuel,
                keyboardType: TextInputType.number,
                decoration: InputDecoration(
                  labelText: "Fuel (litres)",
                  prefixIcon: Icon(Icons.local_gas_station),
                  filled: true,
                  fillColor: Colors.white,
                  border: OutlineInputBorder(),
                ),
                validator: (v) =>
                    v!.isEmpty || double.tryParse(v) == null ||
                    double.parse(v) <= 0
                        ? "Enter valid fuel" : null,
              ),
              SizedBox(height: 20),
              ElevatedButton(
                style: ElevatedButton.styleFrom(
                  backgroundColor: Colors.deepOrange,
                  foregroundColor: Colors.white,
                ),
                onPressed: calculate,
                child: Text("Calculate Mileage"),
              ),
              SizedBox(height: 20),
              Text(
                result,
                style: TextStyle(
                  fontSize: 22,
                  color: Colors.green,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}




